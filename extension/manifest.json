{
  "manifest_version": 3,
  "name": "ShieldIntern - Job Scam Detector",
  "version": "0.1.0",
  "description": "Analyze selected job text for internship scam signals.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShieldIntern - Job Scam Detector"
  }
}
